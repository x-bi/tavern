# syntax=docker/dockerfile:1
#
# Tavern Lite 后端镜像
# 阶段: pnpm install -> prisma generate -> tsc build
# 运行: prisma migrate deploy -> node apps/server/dist/main.js
#
# 说明: 后端运行时不依赖 @tavern/shared(已验证源码无 import),
# 但 build 时 tsc 仍需要 shared 类型解析,故一并 COPY。

FROM node:22-bookworm-slim

# Prisma 6 运行与迁移需要 openssl；ca-certificates 用于 corepack 拉取 pnpm
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# corepack 按 package.json 的 packageManager 启用 pnpm
RUN corepack enable
RUN corepack prepare pnpm@11.7.0 --activate
RUN pnpm config set registry https://registry.npmmirror.com \
 && pnpm config set fetch-retries 5 \
 && pnpm config set fetch-retry-mintimeout 20000 \
 && pnpm config set fetch-retry-maxtimeout 120000 \
 && pnpm config set network-concurrency 3

WORKDIR /app

# 先 COPY 依赖声明文件，利用层缓存：源码改动不会触发重新 install
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/

RUN pnpm install --frozen-lockfile

# COPY 源码、tsconfig、prisma
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/server/tsconfig.json apps/server/
COPY apps/server/src apps/server/src
COPY prisma ./prisma

# 生成 Prisma Client：必须在 tsc build 之前，否则 @prisma/client 类型缺失
RUN pnpm exec prisma generate --schema prisma/schema.prisma

# 编译后端 -> apps/server/dist
RUN pnpm --filter @tavern/server build

# 启动脚本(容错: 去除可能的 Windows CRLF 行尾,避免 Linux 下 sh 报错)
COPY docker-entrypoint.sh ./docker-entrypoint.sh
RUN sed -i 's/\r$//' docker-entrypoint.sh && chmod +x docker-entrypoint.sh

ENV NODE_ENV=production

EXPOSE 3100

ENTRYPOINT ["./docker-entrypoint.sh"]