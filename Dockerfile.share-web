# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS builder
ARG NODE_BUILD_MAX_OLD_SPACE_MB=768
ENV NODE_OPTIONS="--max-old-space-size=${NODE_BUILD_MAX_OLD_SPACE_MB}"
ENV npm_config_jobs=1
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
RUN pnpm config set network-concurrency 1 \
 && pnpm config set child-concurrency 1
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/share-web/package.json apps/share-web/
RUN pnpm install --frozen-lockfile
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/share-web apps/share-web
RUN pnpm --filter @tavern/share-web build

FROM nginx:alpine AS runtime
COPY apps/share-web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/share-web/dist /usr/share/nginx/html
EXPOSE 80
