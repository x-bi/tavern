# syntax=docker/dockerfile:1
#
# Tavern Lite 前端镜像
# 多阶段: builder 用 vite build 产出静态文件 -> runtime 用 nginx 托管

# ---- 构建阶段 ----
FROM node:22-bookworm-slim AS builder

ARG NODE_BUILD_MAX_OLD_SPACE_MB=768
ENV NODE_OPTIONS="--max-old-space-size=${NODE_BUILD_MAX_OLD_SPACE_MB}"
ENV npm_config_jobs=1

RUN corepack enable
RUN corepack prepare pnpm@11.7.0 --activate
RUN pnpm config set registry https://registry.npmmirror.com \
 && pnpm config set fetch-retries 5 \
 && pnpm config set fetch-retry-mintimeout 20000 \
 && pnpm config set fetch-retry-maxtimeout 120000 \
 && pnpm config set network-concurrency 1 \
 && pnpm config set child-concurrency 1
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/

RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/web ./apps/web

# build = vue-tsc 类型检查 + vite build -> apps/web/dist
RUN pnpm --filter @tavern/web build

# ---- 运行阶段: nginx 托管 dist ----
FROM nginx:alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80
