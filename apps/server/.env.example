# Tavern Lite Server
# Do not put real API keys in this file.

NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3100
API_PREFIX=api
REQUEST_BODY_LIMIT=5mb
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Prisma SQLite database.
# The path is resolved relative to prisma/schema.prisma.
DATABASE_URL="file:../data/tavern-lite.db"

# Preconfigured accounts only. Registration is intentionally not provided.
# Replace all sample passwords before deployment. Every account must have a unique username;
# at least one account must use role "admin".
AUTH_PRESET_USERS_JSON='[{"username":"admin","displayName":"Administrator","password":"change-this-admin-password","role":"admin"},{"username":"member1","displayName":"Member 1","password":"change-this-member-password","role":"member"}]'

# Signed lightweight auth token. Use a long random value outside local dev.
AUTH_TOKEN_SECRET="dev-only-change-me"
AUTH_TOKEN_TTL_SECONDS=604800
