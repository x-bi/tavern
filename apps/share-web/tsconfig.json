{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/share-web.tsbuildinfo",
    "rootDir": "../..",
    "outDir": "dist",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/env.d.ts",
    "vite.config.ts",
    "../../packages/shared/src/**/*.ts",
    "../../packages/shared/src/**/*.json"
  ]
}
