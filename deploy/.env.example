# ============================================================
# Tavern Lite 部署环境变量
# 用法:cp deploy/.env.example .env,然后按需修改
# docker compose 会自动读取同目录的 .env 文件
# ============================================================

# ---- 必填 ----
# Token 签名密钥,务必改成随机长字符串(建议 32+ 位)
# 生成方法:openssl rand -hex 32
AUTH_TOKEN_SECRET=请改成随机长字符串_例如_a1b2c3...

# ---- 认证(可选)----
# 是否要求登录密码。false 时单用户免密登录(适合个人/小范围使用)
AUTH_REQUIRE_PASSWORD=false
# 单用户登录用户名
AUTH_SINGLE_USER_USERNAME=demo
# 单用户显示名
AUTH_SINGLE_USER_DISPLAY_NAME=Tavern Admin
# 登录密码(AUTH_REQUIRE_PASSWORD=true 时必填)
AUTH_SINGLE_USER_PASSWORD=

# ---- 跨域(可选)----
# 同源部署(前后端同一个 nginx 出口)时留空即可
# 若前端走独立域名访问,填前端地址,如:https://tavern.example.com
CORS_ORIGINS=

# ---- Token 有效期(可选)----
# 默认 7 天(604800 秒)
AUTH_TOKEN_TTL_SECONDS=604800
