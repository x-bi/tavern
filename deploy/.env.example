# ============================================================
# Tavern Lite 部署环境变量
# 用法:cp deploy/.env.example .env,然后按需修改
# docker compose 会自动读取同目录的 .env 文件
# ============================================================

# ---- 必填 ----
# Token 签名密钥,务必改成随机长字符串(建议 32+ 位)
# 生成方法:openssl rand -hex 32
AUTH_TOKEN_SECRET=请改成随机长字符串_例如_a1b2c3...

# ---- 预置账号(必填)----
# JSON 必须保持在一行；至少包含一个管理员。系统不提供公开注册。
AUTH_PRESET_USERS_JSON=[{"username":"root","displayName":"Root Administrator","password":"0713","role":"admin"}]

# ---- 跨域(可选)----
# 同源部署(前后端同一个 nginx 出口)时留空即可
# 若前端走独立域名访问,填前端地址,如:https://tavern.example.com
# 端口区分模式必须包含 share-web 的完整来源（带 :8081）。
CORS_ORIGINS=http://<公网IP>:8081

# 外部分享链接前缀；当前端口区分模式必须带 :8081，不自动探测公网 IP。
SHARE_PUBLIC_BASE_URL=http://<公网IP>:8081

# NapCat 向 Tavern 推送 OneBot 事件的服务端地址。
# 使用仓库 docker-compose 时保持默认；NapCat 单独部署时改成它能访问的 Tavern /api 地址。
QQ_EVENT_CALLBACK_BASE_URL=http://server:3100/api

# 自动扫码登录使用的 NapCat 容器内地址和二维码挂载路径；仓库 Compose 保持默认即可。
QQ_AUTO_NAPCAT_API_BASE_URL=http://napcat:3000
QQ_LOGIN_QR_PATH=/app/napcat-cache/qrcode.png

# Docker 构建期 Node heap 上限（MB）；低内存服务器默认 768，若出现 heap out of memory 可改为 1024。
NODE_BUILD_MAX_OLD_SPACE_MB=768

# ---- Token 有效期(可选)----
# 默认 7 天(604800 秒)
AUTH_TOKEN_TTL_SECONDS=604800
