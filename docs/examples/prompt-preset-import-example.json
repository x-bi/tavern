{
  "formatVersion": "tavern-lite.prompt-preset.v2",
  "name": "悬疑慢热叙事",
  "description": "适合秘密调查、都市怪谈、慢节奏角色扮演。",
  "instructions": [
    "保持场景连续性，优先描写可感知的细节、人物反应和可追问的线索。",
    "不要一次性揭示全部真相。"
  ],
  "outputRuleOperations": [
    {
      "key": "mystery_response_style",
      "content": "回复控制在 2 到 5 段。避免替用户行动。关键线索用自然叙事呈现，不使用项目符号。",
      "operation": "add",
      "sortOrder": 10
    }
  ],
  "generationPurposes": ["chat_reply", "regenerate", "continue"],
  "parameters": {
    "temperature": 0.82,
    "topP": 0.9,
    "maxTokens": 1200
  },
  "metadata": {
    "tags": ["悬疑", "慢热", "角色扮演"]
  },
  "isDefault": true
}
