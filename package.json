{
  "name": "tavern-lite",
  "version": "0.1.0",
  "private": true,
  "description": "轻量级 AI 酒馆 / 角色对话 Web MVP",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tavern/web --filter @tavern/server dev",
    "dev:web": "pnpm --filter @tavern/web dev",
    "dev:share": "pnpm --filter @tavern/share-web dev",
    "dev:server": "pnpm --filter @tavern/server dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "node prisma/seed.cjs",
    "db:migrate-legacy-admin": "node prisma/migrate-legacy-data-to-admin.cjs",
    "verify:share-layer": "node scripts/verify-share-layer.mjs",
    "verify:content-library": "node scripts/verify-content-library.mjs",
    "verify:companion-ui": "node scripts/verify-companion-ui.mjs",
    "verify:world-book-ui": "node scripts/verify-world-book-ui.mjs",
    "verify:prompt-builder": "pnpm --filter @tavern/server exec tsc -p ../../scripts/tsconfig.json && pnpm --filter @tavern/server exec tsx ../../scripts/verify-prompt-builder.ts",
    "verify:companion-memory": "pnpm --filter @tavern/server exec tsc -p ../../scripts/tsconfig.companion-memory.json && pnpm --filter @tavern/server exec tsx ../../scripts/verify-companion-memory.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "workspace:list": "pnpm -r list --depth -1"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@prisma/client": "^6.19.3",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.19.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
