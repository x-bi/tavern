generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String
  passwordHash String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  appSettings         AppSetting[]
  assets              Asset[]
  characters          Character[]
  conversations       Conversation[]
  modelFallbackGroups ModelFallbackGroup[]
  modelProviders      ModelProvider[]
  personas            UserPersona[]
  promptPresets       PromptPreset[]
  worldBooks          WorldBook[]

  @@index([isActive])
  @@index([deletedAt])
}

model Character {
  id                  String    @id @default(cuid())
  userId              String
  avatarAssetId       String?
  name                String
  description         String    @default("")
  personality         String    @default("")
  scenario            String    @default("")
  firstMessage        String    @default("")
  exampleMessagesJson String?
  metadataJson        String?
  isSensitive         Boolean   @default(false)
  isArchived          Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  avatarAsset   Asset?         @relation("CharacterAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldBooks    WorldBook[]

  @@index([userId])
  @@index([userId, isSensitive])
  @@index([userId, isArchived])
  @@index([name])
  @@index([deletedAt])
}

model ModelProvider {
  id               String    @id @default(cuid())
  userId           String
  name             String
  provider         String    @default("openai-compatible")
  baseUrl          String
  apiKeyCiphertext String?
  apiKeyMask       String?
  timeout          Int?
  isDefault        Boolean   @default(false)
  isEnabled        Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  models ProviderModel[]
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, isEnabled])
  @@index([provider])
  @@index([deletedAt])
}

model ProviderModel {
  id                String    @id @default(cuid())
  providerId        String
  name              String
  model             String
  defaultParamsJson String?
  contextLength     Int?
  notes             String?
  sortOrder         Int       @default(0)
  isEnabled         Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  fallbackCandidates ModelFallbackCandidate[]
  provider           ModelProvider            @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, name])
  @@unique([providerId, model])
  @@index([providerId, isEnabled])
  @@index([deletedAt])
}

model ModelFallbackGroup {
  id        String    @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean   @default(false)
  isEnabled Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  candidates    ModelFallbackCandidate[]
  conversations Conversation[]
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, isEnabled])
  @@index([deletedAt])
}

model ModelFallbackCandidate {
  id        String   @id @default(cuid())
  groupId   String
  modelId   String
  priority  Int
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group ModelFallbackGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  model ProviderModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([groupId, modelId])
  @@unique([groupId, priority])
  @@index([modelId])
}

model PromptPreset {
  id             String    @id @default(cuid())
  userId         String
  name           String
  description    String    @default("")
  systemPrompt   String    @default("")
  outputRules    String    @default("")
  parametersJson String?
  metadataJson   String?
  isSensitive    Boolean   @default(false)
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  conversations Conversation[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, isSensitive])
  @@index([userId, isDefault])
  @@index([deletedAt])
}

model UserPersona {
  id           String    @id @default(cuid())
  userId       String
  name         String
  content      String    @default("")
  metadataJson String?
  isSensitive  Boolean   @default(false)
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  conversations Conversation[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, isSensitive])
  @@index([userId, isDefault])
  @@index([deletedAt])
}

model Conversation {
  id                   String    @id @default(cuid())
  userId               String
  characterId          String
  modelFallbackGroupId String?
  promptPresetId       String?
  personaId            String?
  title                String
  status               String    @default("active")
  metadataJson         String?
  usesSensitiveResource Boolean   @default(false)
  lastMessageAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  character          Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages           Message[]
  modelFallbackGroup ModelFallbackGroup? @relation(fields: [modelFallbackGroupId], references: [id], onDelete: SetNull)
  persona            UserPersona?        @relation(fields: [personaId], references: [id], onDelete: SetNull)
  promptPreset       PromptPreset?       @relation(fields: [promptPresetId], references: [id], onDelete: SetNull)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, usesSensitiveResource])
  @@index([characterId, updatedAt])
  @@index([modelFallbackGroupId])
  @@index([status])
  @@index([deletedAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  role           String
  content        String
  status         String    @default("complete")
  metadataJson   String?
  tokenCount     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  conversation          Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([role])
  @@index([status])
}

model WorldBook {
  id           String    @id @default(cuid())
  userId       String
  characterId  String?
  name         String
  description  String    @default("")
  isEnabled    Boolean   @default(true)
  scanDepth    Int       @default(6)
  tokenBudget  Int       @default(1000)
  metadataJson String?
  isSensitive  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  character Character?       @relation(fields: [characterId], references: [id], onDelete: SetNull)
  entries   WorldBookEntry[]
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isEnabled])
  @@index([userId, isSensitive])
  @@index([characterId])
  @@index([deletedAt])
}

model WorldBookEntry {
  id                    String    @id @default(cuid())
  worldBookId           String
  title                 String
  content               String
  keywordsJson          String
  secondaryKeywordsJson String?
  isEnabled             Boolean   @default(true)
  priority              Int       @default(0)
  position              String    @default("before_history")
  tokenBudget           Int?
  caseSensitive         Boolean   @default(false)
  metadataJson          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  worldBook WorldBook @relation(fields: [worldBookId], references: [id], onDelete: Cascade)

  @@index([worldBookId, isEnabled])
  @@index([priority])
  @@index([deletedAt])
}

model Asset {
  id           String    @id @default(cuid())
  userId       String
  kind         String
  fileName     String
  originalName String?
  mimeType     String
  extension    String?
  sizeBytes    Int
  storagePath  String
  publicPath   String?
  metadataJson String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  characterAvatars Character[] @relation("CharacterAvatar")
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([createdAt])
  @@index([deletedAt])
}

model AppSetting {
  id        String   @id @default(cuid())
  userId    String?
  scope     String   @default("global")
  key       String
  value     String
  valueType String   @default("string")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scope, key])
  @@index([userId])
}
